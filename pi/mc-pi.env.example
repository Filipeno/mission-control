# Copy of what `python3 mcpi.py setup` and install-ntfy.sh write to mc-pi.env (mode 0600, never commit it).
BIND=0.0.0.0
PORT=8780
# pc-waker runs on the same Pi. mc-pi reads its password hash + signing key from pc-waker.env.
PCW_URL=http://127.0.0.1:8765
PCW_ENV=/home/filip/pc-waker/pc-waker.env
# ntfy on the same Pi; mc-pi posts here, not through the tunnel.
NTFY_URL=http://127.0.0.1:2586
NTFY_TOKEN=<ntfy token of user mc-pi, written by install-ntfy.sh>
# The PC helper (pc/mc-pc.ps1) sends this. Generated by setup.
PC_TOKEN=<generated>
# Shown in the app's Settings to set up the ntfy app on the phone.
NTFY_PUBLIC=https://<ntfy hostname in the Cloudflare tunnel>
NTFY_LAN=http://<pi-address>:2586

# --- stage 6: System tab (all optional) ---
# Slime Keepers card. Public numbers need only the universe id; earnings need a read-only Open Cloud key
# (permission universe.analytics:read). Set the key with:  .venv/bin/python mcpi.py roblox-key   (hidden prompt)
ROBLOX_UNIVERSE=<universe id of the Live game>
ROBLOX_KEY=
# Mini PC (Home Assistant OS). URL = ping + "HA answers". Token of a NON-admin HA user = also temp/disk/uptime:
#   .venv/bin/python mcpi.py ha-token   (hidden prompt). The three entity ids are System Monitor sensors.
HA_URL=http://<mini-pc-address>:8123
HA_TOKEN=
HA_TEMP=sensor.processor_temperature
HA_DISK=sensor.disk_use_percent
HA_UPTIME=sensor.uptime

# --- the laptop as a second host (all optional; empty = off) ---
# /api/host/* only answers clients inside these networks (comma-separated CIDRs). Loopback is always refused. Empty = nobody.
HOST_ALLOW_NETS=
# Wake-on-LAN for the laptop, sent by mc-pi itself. The broadcast address and the Pi's own address (source) are optional.
HOST_LAPTOP_MAC=
HOST_LAPTOP_BCAST=
HOST_LAPTOP_SOURCE_IP=
# Laptop address for the "is it asleep" probe (TCP 22 / 47990). Empty = state stays unknown without a report.
HOST_LAPTOP_IP=
